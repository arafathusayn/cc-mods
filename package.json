{
  "name": "cc-mods",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "new": "bun scripts/cli/new-mod.ts",
    "check": "bun scripts/cli/check.ts",
    "sync-types": "bun scripts/cli/sync-types.ts",
    "sync-kernel": "bun scripts/cli/sync-kernel.ts",
    "test": "bun test ./tests",
    "typecheck": "tsc -p tsconfig.json && tsc -p mods/tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
